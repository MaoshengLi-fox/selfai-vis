    psnr = train_model(lr, k2)
    trial_result = {'k2': k2, 'lr': lr, 'PSNR': psnr}
    hyperparameter_tuning_state['trials'].append(trial_result)
    hyperparameter_tuning_state['completed_trials'] += 1

print(hyperparameter_tuning_state)
```
