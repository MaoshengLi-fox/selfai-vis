def simulate_model(lr, k2):
    # This should be replaced with the actual logic of your model's train and eval
    return 20.0 + (lr * 10) + (k2 * 100)

study = optuna.create_study(direction='maximize')
n_trials = 25

study.optimize(objective, n_trials=n_trials)

